# =============================================================================
# Web Purchase — environment variables
# Copy to .env.local for development. In Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real secrets.
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=zero6ixlimited@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+234 803 617 7408
# WhatsApp number for the floating chat button (digits, international format)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348036177408
NEXT_PUBLIC_OFFICE_ADDRESS=28 Chief Charles Street, off Peace Drive, Trans Amadi, Port Harcourt, Rivers State, Nigeria
# Legal entity shown in the footer, contact page, legal pages and invoices
NEXT_PUBLIC_COMPANY_NAME=Zero6ix Limited
# Shown only when set, e.g. "RC 1234567"
NEXT_PUBLIC_RC_NUMBER=RC 8922251
# Login, sign-up, dashboards, admin, order tracking and payment links stay hidden
# (redirect to the home page; request buttons open WhatsApp) until this is "true".
# Turn on only after Supabase and the payment keys are configured.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false

# --- Supabase (Project Settings → API) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security -----------------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts client-shared service credentials (AES-256-GCM). Rotating it makes
# existing stored credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Set to "false" ONLY for local development without an SMS provider.
REQUIRE_PHONE_VERIFICATION=true

# --- Payments -----------------------------------------------------------------
# Paystack: Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxx
# Flutterwave: Dashboard → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
# Flutterwave: Dashboard → Settings → Webhooks → "Secret hash" (any random string you choose)
FLUTTERWAVE_WEBHOOK_HASH=

# --- Exchange rates -------------------------------------------------------------
# Any ExchangeRate-API compatible endpoint with USD base. Default is free & keyless.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# --- Email (Resend) -------------------------------------------------------------
# Needed for the contact form to email you before the database is connected.
# Quick start: sign up at resend.com with the inbox below and leave EMAIL_FROM unset
# (uses onboarding@resend.dev); later verify your domain and set EMAIL_FROM.
RESEND_API_KEY=
# Where contact-form messages are sent (defaults to NEXT_PUBLIC_SUPPORT_EMAIL)
CONTACT_FORM_TO=zero6ixlimited@gmail.com
EMAIL_FROM=
# Comma-separated list that receives ops alerts (new requests, payments, hand-offs)
OPS_NOTIFICATION_EMAIL=zero6ixlimited@gmail.com

# --- WhatsApp Business (Meta Cloud API) ------------------------------------------
# Meta for Developers → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App → Settings → Basic → App Secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; enter the same value when configuring the webhook in Meta
WHATSAPP_VERIFY_TOKEN=
# Approved utility template for status updates outside the 24h window.
# Body must have two params: {{1}} = first name, {{2}} = update text.
WHATSAPP_STATUS_TEMPLATE=order_update
WHATSAPP_TEMPLATE_LANG=en
